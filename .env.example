# ==========================================================
# Modelo de variaveis de ambiente
# Copie para .env e preencha. NUNCA comite o arquivo .env.
# Toda variavel nova precisa ser declarada aqui, sem valor real.
# ==========================================================

# --- Aplicacao ---
NODE_ENV=development
APP_NAME=nome-do-projeto
APP_URL=http://localhost:3000
PORT=3000
LOG_LEVEL=info

# --- Banco de dados ---
DATABASE_URL=

# --- Cache ---
REDIS_URL=

# --- Autenticacao ---
# Gere um valor aleatorio forte por ambiente. Nunca reutilize entre ambientes.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Integracoes externas ---
# Use tokens com o menor escopo possivel e rotacione a cada 90 dias.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Observabilidade ---
SENTRY_DSN=

# --- Feature flags ---
FEATURE_NEW_CHECKOUT=false
