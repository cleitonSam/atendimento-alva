# =============================================================================
# ALVA IA TECH — variáveis EXTRAS (além do .env.example do Chatwoot)
# Cole no EasyPanel em CADA serviço (web E worker). Não commitar valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) STORAGE (S3-compatível) — resolve avatar 500, anexo "100 Upload failure" e
#    thumbnails. A app e a Meta precisam baixar os arquivos por URL pública.
#    Serve Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO, etc.
#    (ImageKit NÃO entra aqui — ImageKit é só pro publish do carrossel, item 2.)
# -----------------------------------------------------------------------------
ACTIVE_STORAGE_SERVICE=s3_compatible
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
STORAGE_BUCKET_NAME=
STORAGE_ENDPOINT=            # ex.: https://<accountid>.r2.cloudflarestorage.com
STORAGE_FORCE_PATH_STYLE=false   # true só p/ MinIO
# (alternativa AWS S3 puro: ACTIVE_STORAGE_SERVICE=amazon + AWS_ACCESS_KEY_ID/
#  AWS_SECRET_ACCESS_KEY/AWS_REGION/S3_BUCKET_NAME)

# -----------------------------------------------------------------------------
# 2) IMAGEKIT — host público das imagens do carrossel (Fase 2 / publicar post).
#    A Meta baixa a imagem por URL; o ImageKit entrega URL pública.
#    A PRIVATE KEY fica SÓ aqui no ENV, NUNCA no código.
# -----------------------------------------------------------------------------
IMAGEKIT_PUBLIC_KEY=public_rrpT6VkurQWkWCUAMdC1HGcI1Sc=
IMAGEKIT_PRIVATE_KEY=        # copie a chave privada completa do painel do ImageKit
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/5tinemjsg

# -----------------------------------------------------------------------------
# 3) SMTP da caixa de e-mail (enviar) — sem isso a inbox só recebe (IMAP).
#    No Chatwoot o SMTP também é configurável POR INBOX (Configuração -> SMTP);
#    estas ENVs são o SMTP GLOBAL (fallback). Hostinger:
# -----------------------------------------------------------------------------
SMTP_ADDRESS=smtp.hostinger.com
SMTP_PORT=465
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_USERNAME=               # ex.: cleiton.sampaio@alvaiatech.com.br
SMTP_PASSWORD=
MAILER_SENDER_EMAIL=Alva IA <no-reply@alvaiatech.com.br>

# -----------------------------------------------------------------------------
# 4) INSTAGRAM — DM fora da janela de 24h (tag Human Agent -> 7 dias).
#    Precisa da feature "Human Agent" aprovada no app Meta.
#    (Isto é um GlobalConfig; também dá pra ligar em Super Admin -> Configurações.)
# -----------------------------------------------------------------------------
ENABLE_INSTAGRAM_CHANNEL_HUMAN_AGENT=true
